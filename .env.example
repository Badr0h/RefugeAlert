# Spring Boot API (backend/). Defaults in application.yml match docker-compose.yml.

# HTTP port
PORT=8080
# Spring profile: dev (local) or prod
SPRING_PROFILES_ACTIVE=dev
# PostgreSQL connection (JDBC or postgres:// URL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/refugealert
# PostgreSQL user (local docker-compose value)
SPRING_DATASOURCE_USERNAME=refugealert
# PostgreSQL password (local docker-compose value)
SPRING_DATASOURCE_PASSWORD=refugealert
# Front-end origin allowed by CORS and used in email links
FRONTEND_URL=http://127.0.0.1:3000
# Sender of alert emails
MAIL_FROM=AlerteGR20 <alertes@example.com>
# Resend API key; when empty, emails are only logged
RESEND_API_KEY=
# Last night of the monitored season (ISO date)
SAISON_FIN=2026-10-04
# Paddle server API key
PADDLE_API_KEY=
# Paddle webhook signing secret
PADDLE_WEBHOOK_SECRET=
# Paddle price ID of the paid alert
PADDLE_PRICE_ID=
# Paddle API base URL (sandbox shown; production is https://api.paddle.com)
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com

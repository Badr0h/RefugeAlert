# Front-end under test (defaults to the production site)
E2E_BASE_URL=https://alertegr20.com
# Spring Boot API under test (the hosted API is stopped since October 2026)
E2E_API_URL=http://localhost:8080
# Required: an inbox you read, ideally a "+" alias, that receives test alerts
E2E_EMAIL=you+e2e@example.com
# Optional: token from a real unsubscribe link, enables the full unsubscribe scenario
E2E_UNSUB_TOKEN=

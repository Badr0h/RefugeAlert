# Spring Boot API base URL (places board, alerts, checkout)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Paddle client-side token for the checkout overlay
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Opening-day list (route /api/ouverture), independent of the Spring Boot API
# Resend API key with full access (needed to manage contacts)
RESEND_API_KEY=
# Resend segment ID of the opening-day list
RESEND_OUVERTURE_SEGMENT_ID=
# Secret used to sign confirmation links (long random string)
OUVERTURE_TOKEN_SECRET=
# Sender of confirmation emails (verified Resend domain)
MAIL_FROM=AlerteGR20 <alertes@example.com>
# Optional: reply-to address of confirmation emails (defaults to the site contact)
MAIL_REPLY_TO=contact@example.com
# Optional: confirmation emails allowed per UTC day (defaults to 60)
OUVERTURE_DAILY_CAP=60
